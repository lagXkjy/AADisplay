<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp">

        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="@dimen/notification_action_icon_size"
            android:layout_height="@dimen/notification_action_icon_size"
            android:scaleType="centerCrop"
            android:layout_marginBottom="5dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@+id/v_card"
            app:layout_constraintBottom_toTopOf="@+id/v_card"
            tools:srcCompat="@drawable/ic_round_check_circle_24"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="4dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textAppearance="?textAppearanceBodyMedium"
            android:textColor="?colorOnPrimary"
            android:textSize="15sp"
            app:layout_constraintStart_toEndOf="@+id/iv_icon"
            app:layout_constraintEnd_toEndOf="@+id/v_card"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
            tools:text="@string/app_name"/>

        <!-- Gray card chrome only; no task thumbnail. Hosts centered Close. -->
        <View
            android:id="@+id/v_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_recent_card"
            app:layout_constraintWidth_percent="0.6"
            app:layout_constraintDimensionRatio="H,9:16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:id="@+id/ib_close"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_recent_close_circle"
            android:contentDescription="@android:string/cancel"
            android:padding="12dp"
            android:src="@drawable/ic_close_24"
            app:layout_constraintTop_toTopOf="@+id/v_card"
            app:layout_constraintBottom_toBottomOf="@+id/v_card"
            app:layout_constraintStart_toStartOf="@+id/v_card"
            app:layout_constraintEnd_toEndOf="@+id/v_card"
            app:tint="?colorOnPrimary" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
